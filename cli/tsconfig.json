{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": "..",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "../sdk/**/*.ts",
    "../scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "../sdk/node_modules", "../scripts/node_modules"]
}
