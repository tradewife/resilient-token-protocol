# Dashboard env — local-only template. Real values live on Railway per service.
# Copy to .env.local for `pnpm dev`, or set via Railway for rtp-dashboard.

# Active rtp-trader wallet pubkey (44-char base58). Required for the mainnet
# balance lookup. Without this, the dashboard falls back to a legacy pubkey
# that is no longer funded.
RTP_TRADER_WALLET_PUBKEY=

# Same value exposed to the browser. Next inlines NEXT_PUBLIC_* at build time.
NEXT_PUBLIC_RTP_TRADER_WALLET_PUBKEY=

# Set by Railway at runtime. rtp-dashboard reads RAILWAY_SERVICE_RTP_TRADER_URL
# to discover the trader service over private networking. The dashboard's
# /api/trader-status route forwards /state from the live trader.
# Railway-managed; do not set manually.
# RAILWAY_SERVICE_RTP_TRADER_URL=http://rtp-trader.railway.internal
# TRADER_STATUS_URL=http://rtp-trader.railway.internal
