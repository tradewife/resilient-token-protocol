# ============================================================
# RTP — Resilient Token Protocol
# .gitignore
#
# Source code (scripts, backtesting, agents, strategies) is
# committed — collaborator needs it to build and run locally.
# Only data, artifacts, and secrets are excluded.
# ============================================================

# --- Data (too large for repo, fetch locally) ---
data/

# --- Python artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
.Python

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Secrets ---
.env
*.env
credentials.json
*.pem
*.key
