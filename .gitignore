# ============================================================
# RTP — Resilient Token Protocol
# .gitignore
#
# Source code (research/, rtp/) is committed — collaborator
# needs it to build and run locally.
# Only data, artifacts, and secrets are excluded.
# ============================================================

# --- Data (too large for repo, fetch locally) ---
data/*
!data/ohlcv/
!data/ohlcv/**
!data/night_results/
!data/night_results/**

# --- Python artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
.Python

# --- IDE ---
.idea/
.vscode/
.codex
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Secrets ---
.env
.env.*
*.env
credentials.json
*.pem
*.key

# --- Anchor / Solana build artifacts ---
target/
anchor/target/
**/target/deploy/*.json
node_modules/
.anchor/
test-ledger/

# --- PyInstaller build artifacts ---
night_shift.bin
*.spec.bak

# --- Configs with secrets ---
configs/*.json
configs/.env*
