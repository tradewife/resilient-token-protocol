{
  "version": "1.0",
  "schedule": {
    "fetch_fresh_data": true,
    "max_hours_runtime": 8
  },
  "symbols": ["BTC/USDT", "ETH/USDT", "SOL/USDT", "BNB/USDT"],
  "wfa": {
    "num_folds": 10,
    "test_fold_days": 36,
    "min_trades_per_fold": 10
  },
  "grid_search": {
    "coarse": true,
    "fine_refinement_top_n": 100,
    "darwinian_generations": 5,
    "darwinian_population": 50
  },
  "overfitting": {
    "max_is_oos_gap": 0.5,
    "min_oos_consistency": 0.50,
    "max_fragility": 0.4
  },
  "regime_analysis": {
    "adx_threshold": 25.0,
    "volatility_percentile_window": 60
  },
  "validation": {
    "top_candidates": 3
  },
  "strategy_exploration": {
    "enabled": true,
    "use_llm": true,
    "n_strategies": 3,
    "position_pct": 0.20,
    "initial_capital": 100.0,
    "max_candidates": 500,
    "note": "Explore alternative strategies via plugins. use_llm requires LLM_API_KEY."
  },
  "robustness": {
    "enabled": true,
    "top_n": 3,
    "mc_simulations": 10000,
    "cpcv_folds": 10,
    "cpcv_test_folds": 3,
    "cpcv_variants": 20,
    "position_pct": 0.20,
    "note": "Monte Carlo DD + CPCV + PBO on top candidates."
  },
  "experiments": [
    {
      "name": "tighter_stops_wider_tp",
      "type": "param_override",
      "params": {
        "stop_loss_atr": [0.8, 1.0, 1.25],
        "take_profit_atr": [3.5, 4.0, 5.0, 6.0]
      },
      "note": "test tighter stops + moderate TP — the pattern that worked for SOL"
    },
    {
      "name": "shorter_holds",
      "type": "param_override",
      "params": {
        "max_hold_hours": [24, 36, 48],
        "time_decay_hours": [24, 36, 48]
      },
      "note": "test shorter holding periods — optimizer converged on 36-48h for SOL"
    },
    {
      "name": "lower_threshold",
      "type": "param_override",
      "params": {
        "signal_threshold": [0.30, 0.35, 0.40, 0.45]
      },
      "note": "sweep entry threshold — SOL showed 0.35 is better than production 0.40"
    },
    {
      "name": "leverage_3x_tight_stops",
      "type": "param_override",
      "params": {
        "leverage": [3.0],
        "stop_loss_atr": [0.5, 0.75, 1.0, 1.25, 1.5, 2.0],
        "trailing_stop_atr": [0.0, 0.3, 0.5]
      },
      "note": "3x leverage with tight stops — leverage sweep winner was 3x sl=2.5 trail=0.3"
    },
    {
      "name": "leverage_5x_wide_stops",
      "type": "param_override",
      "params": {
        "leverage": [5.0],
        "stop_loss_atr": [1.5, 2.0, 2.5, 3.0],
        "trailing_stop_atr": [0.0, 0.3, 0.5]
      },
      "note": "5x leverage with wider stops — aggressive but DD near 25% ceiling"
    }
  ],
  "output_dir": "data/night_results"
}