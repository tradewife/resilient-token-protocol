# Node 22+ required for built-in node:sqlite (intake lead store).
FROM node:22-slim AS deps
WORKDIR /app
COPY sdk/package.json sdk/package.json
COPY sdk/idl.ts sdk/idl.ts
COPY sdk/README.md sdk/README.md
COPY dashboard/package.json dashboard/package-lock.json dashboard/
RUN cd dashboard && npm ci

FROM node:22-slim AS builder
WORKDIR /app
# NEXT_PUBLIC_ vars must be present at build time for Next.js to inline
# them. Railway injects env vars as build args.
ARG NEXT_PUBLIC_RTP_DIAGNOSTIC_PAY_URL
ENV NEXT_PUBLIC_RTP_DIAGNOSTIC_PAY_URL=${NEXT_PUBLIC_RTP_DIAGNOSTIC_PAY_URL}
ARG NEXT_PUBLIC_RTP_DIAGNOSTIC_CAL_URL
ENV NEXT_PUBLIC_RTP_DIAGNOSTIC_CAL_URL=${NEXT_PUBLIC_RTP_DIAGNOSTIC_CAL_URL}
ARG NEXT_PUBLIC_RTP_TRADER_WALLET_PUBKEY
ENV NEXT_PUBLIC_RTP_TRADER_WALLET_PUBKEY=${NEXT_PUBLIC_RTP_TRADER_WALLET_PUBKEY}
COPY --from=deps /app/dashboard/node_modules dashboard/node_modules
COPY --from=deps /app/sdk sdk
COPY dashboard/ dashboard/
RUN cd dashboard && npm run build

FROM node:22-slim AS runner
# v3: Node 22 for node:sqlite; intake DB on Railway volume at /data
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME="0.0.0.0"
ENV PORT=3000
# Default SQLite path — override with RTP_INTAKE_DB_PATH if needed.
# Mount a Railway volume at /data so this survives redeploys.
ENV RTP_INTAKE_DB_PATH=/data/intake.sqlite
COPY --from=builder /app/dashboard/.next/standalone ./
COPY --from=builder /app/dashboard/.next/static .next/static
COPY --from=builder /app/dashboard/public ./public
EXPOSE 3000
# HEALTHCHECK is handled by Railway via healthcheckPath=/ (set via GraphQL).
# Removing from Dockerfile to avoid interference with Railway's own health check.
CMD ["node", "server.js"]
