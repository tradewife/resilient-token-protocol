# rustc 1.90+ required: gmsol-sdk's dep chain pulls ruint 1.20 which has
# rust-version 1.90. Match the dev toolchain (1.94).
ARG RUST_VERSION=1.94-slim
FROM rust:${RUST_VERSION} AS builder
# git + ca-certificates: cargo fetches gmsol-sdk from a public git repo.
# make + perl: the dep chain (solana-secp256r1-program -> openssl) builds a
# vendored OpenSSL from source; without make/perl the build fails.
RUN apt-get update && apt-get install -y pkg-config libssl-dev git ca-certificates make perl && rm -rf /var/lib/apt/lists/*
WORKDIR /build

# Force cache bust on every build
ARG CACHEBUST=1

COPY rtp/swarm/Cargo.toml rtp/swarm/Cargo.lock ./
COPY rtp/swarm/src/ src/
COPY rtp/swarm/tests/ tests/

RUN cargo build --release --bin rtp-trader

# Stage 2: build a trimmed Node wrapper + its dependency tree so the runtime
# image doesn't need npm at boot. The wrapper is a thin JSON-RPC bridge to
# @flash_trade/flash-sdk-v2 (see cli/flash-sdk-wrapper.mjs).
FROM node:20-bookworm-slim AS wrapper
WORKDIR /wrapper
COPY cli/package.json cli/package-lock.json ./
COPY cli/flash-sdk-wrapper.mjs ./
RUN npm ci --omit=dev --no-audit --no-fund

# Runtime: debian for the Rust binary + Node 20 binary from the official image.
# Do NOT use Debian's `nodejs` package (v18) — the wrapper needs Node 20, and
# `node --input-type=module file.mjs` is invalid on Node 18.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/rtp-trader /usr/local/bin/

# Keypair written from env var at startup (same pattern as daemon)
RUN mkdir -p /app/keys /app/config /data /app/wrapper

COPY data/trader-strategy-config.json /app/config/strategy.json

# Copy the prepared wrapper + node_modules from the wrapper stage
COPY --from=wrapper /wrapper /app/wrapper
# Node 20 binary from the same image that built the wrapper (matches bookworm libc)
COPY --from=wrapper /usr/local/bin/node /usr/local/bin/node

ENV RTP_TRADER_KEYPAIR=/app/keys/trader.json
ENV RTP_TRADER_STATE_PATH=/data/trader-state.json
ENV RTP_TRADER_HTTP_PORT=8080
ENV RTP_STRATEGY_CONFIG=/app/config/strategy.json

# Wrapper location + Flash Trade endpoints (overrideable via Railway env)
# Trading txs must submit to the v2/ER RPC; funds ops use Solana mainnet RPC.
# See https://docs.flash.trade/flash-trade/flash-trade-protocol/build-on-flash/flash-trade-v2/signing-and-submitting.md
ENV RTP_TRADER_WRAPPER_PATH=/app/wrapper/flash-sdk-wrapper.mjs
ENV RTP_TRADER_ER_RPC=https://flash.magicblock.xyz
ENV RTP_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

EXPOSE 8080

CMD sh -c 'if [ -n "$RTP_TRADER_KEYPAIR_JSON" ]; then echo "$RTP_TRADER_KEYPAIR_JSON" > /app/keys/trader.json; fi && rtp-trader'
